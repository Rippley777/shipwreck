# Omit for local embedded PostgreSQL; deployed embedded storage requires EMBEDDED_DATABASE_PATH.
DATABASE_URL=
# Optional explicit embedded storage for a single-process deployment (Azure F1 uses /home/shipwreck/data).
EMBEDDED_DATABASE_PATH=
# Azure deployment sets APP_URL automatically; see docs/AZURE_DEPLOYMENT.md.
APP_URL=http://localhost:3000
# Additional browser origins allowed to make API write requests (comma-separated).
ALLOWED_ORIGINS=https://shipwreck.oddware.dev
# Generate: openssl rand -hex 32. Required for GitHub OAuth token encryption.
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Private repository access: a GitHub App with Contents: read and Metadata: read.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM key; use literal \n escapes for environment variables, or a mounted key file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Enables isolated demo sessions in deployed environments. Demo never has GitHub credentials.
ENABLE_DEMO=true

# Docker Compose only; use a long, random password.
POSTGRES_PASSWORD=
