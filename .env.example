# Omit for persistent embedded PostgreSQL in .shipwreck/data (local development only).
DATABASE_URL=
APP_URL=http://localhost:3000
# Generate: openssl rand -hex 32. Required for GitHub OAuth token encryption.
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Enables isolated demo sessions in deployed environments. Demo never has GitHub credentials.
ENABLE_DEMO=true

# Docker Compose only; use a long, random password.
POSTGRES_PASSWORD=
